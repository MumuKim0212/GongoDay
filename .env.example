# 오늘공고 — 환경 변수 템플릿
#
# 이 파일은 커밋한다 (값 없이 키 이름만).
# 실제 값은 .env.local 에 넣고, 그 파일은 절대 커밋하지 않는다.
#
# 대응 문서: docs/ARCHITECTURE.md §8

# ─────────────────────────────────────────────
# Supabase — 브라우저에 노출됨 (RLS가 통제)
# 대시보드 > Project Settings > API
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────
# 서버 전용 — 브라우저에 노출되면 안 됨
# NEXT_PUBLIC_ 접두사를 붙이지 말 것
# ─────────────────────────────────────────────

# Supabase service_role — policies 테이블 쓰기 (수집 라우트 전용)
# RLS를 무시하는 키다. lib/supabase/admin.ts 에서만 읽는다.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — AI 판정
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 온통청년 청년정책 API — 요청 파라미터 apiKeyNm
# https://www.youthcenter.go.kr 마이페이지 > OPEN API
YOUTH_API_KEY=

# 정부24 공공서비스 정보 API (odcloud) — 요청 파라미터 serviceKey
# https://www.data.go.kr 마이페이지 > 개발계정
# 주의: 인코딩키/디코딩키 두 종류가 발급된다. 쿼리스트링에 직접 붙이면 디코딩키를 쓰고,
#       fetch가 자동 인코딩하는 경우 이중 인코딩되지 않는지 확인할 것 (작업 0-B에서 검증)
GOV24_API_KEY=
